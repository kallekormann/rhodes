NEXT_PUBLIC_SUPABASE_URL=http://localhost:3001/app/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379

# Team invite emails (Mailpit UI: http://localhost:8025, SMTP on host port 1026)
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_FROM=dev@rhodes.local
SMTP_SENDER_NAME=Rhodes

# Billing tier override for local dev: free | basic | pro | team
NEXT_PUBLIC_MOCK_TIER=free

# -----------------------------------------------------------------------------
# Ollama — one host; models differ per feature (restart web/worker after change).
# Catalog (pull first via ./scripts/pull-models.sh):
#   Generate: llama3.2:3b-instruct-q4_K_M (fast CPU) | llama3.1:8b-instruct-q4_K_M (quality)
#   Embed:    nomic-embed-text
# Mac Metal host Ollama: OLLAMA_HOST=http://host.docker.internal:11434
# -----------------------------------------------------------------------------

# Base URL for the Ollama HTTP API (Docker service or host Metal).
OLLAMA_HOST=http://localhost:11434

# Fallback generate model when a usage-specific model below is unset.
# Alias: OLLAMA_FAST_MODEL
OLLAMA_DEFAULT_GENERATE_MODEL=llama3.2:3b-instruct-q4_K_M

# Embedding model for library index, Insights retrieval, and Ask retrieval.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Max wait for a single embed / embedBatch call (ms).
OLLAMA_EMBED_TIMEOUT_MS=90000

# Ask panel answer stream (primary). Alias: OLLAMA_CHAT_MODEL
OLLAMA_ASK_MODEL=llama3.2:3b-instruct-q4_K_M

# Ask fallback if the primary model is missing (HTTP 404 from Ollama).
OLLAMA_ASK_FALLBACK_MODEL=llama3.2:3b-instruct-q4_K_M

# Set to 1 to run LLM keep/skip rerank before Ask answers (slower on CPU).
# Alias: ASK_LLM_RERANK
OLLAMA_ASK_LLM_RERANK=0

# Model used only when OLLAMA_ASK_LLM_RERANK=1.
OLLAMA_RERANK_MODEL=llama3.2:3b-instruct-q4_K_M

# Editor writing-helper suggestions.
OLLAMA_WRITING_COACH_MODEL=llama3.2:3b-instruct-q4_K_M

# Insights “Why relevant?” explanations.
OLLAMA_WHY_RELEVANT_MODEL=llama3.2:3b-instruct-q4_K_M

# Library file summaries after ingest (worker).
OLLAMA_SUMMARY_MODEL=llama3.2:3b-instruct-q4_K_M

# Max wait for one library summary generate call (ms).
OLLAMA_SUMMARY_TIMEOUT_MS=180000

# Document metadata auto-fill extraction (worker).
OLLAMA_METADATA_MODEL=llama3.2:3b-instruct-q4_K_M

# Default timeout for non-embed generate / streamGenerate calls (ms).
OLLAMA_GENERATE_TIMEOUT_MS=120000

# Optional library quota overrides (MB). Unset = tier defaults from packages/shared/src/tiers.ts
# RHODES_LIBRARY_STORAGE_MB_FREE=100
# RHODES_LIBRARY_STORAGE_MB_BASIC=1024
# RHODES_LIBRARY_STORAGE_MB_PRO=5120
# RHODES_LIBRARY_STORAGE_MB_TEAM=51200
# RHODES_LIBRARY_MAX_FILE_MB_FREE=2
# RHODES_LIBRARY_MAX_FILE_MB_BASIC=5
# RHODES_LIBRARY_MAX_FILE_MB_PRO=10
# RHODES_LIBRARY_MAX_FILE_MB_TEAM=30
